# ==============================================================================
# بيئة الإعدادات العامة لقالب SaaS Starter المطور
# ==============================================================================

# 1. قاعدة البيانات (MongoDB)
# يمكنك استخدام MongoDB محلياً أو سحابياً من MongoDB Atlas (نفس مشروع SAAS)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saas_db?retryWrites=true&w=majority

# 2. أمان الجلسات والتشفير (JWT Secrets)
JWT_SECRET=super_secret_jwt_key_please_change_in_production_123456
JWT_EXPIRES_IN=7d

# 3. إعدادات البريد الإلكتروني (Nodemailer SMTP)
# يمكنك استخدام Gmail (App Password) أو Mailtrap أو أي سيرفر SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME="منصتي - My SaaS"
EMAIL_FROM_ADDRESS=noreply@mysaas.com

# 4. تسجيل الدخول بواسطة جوجل (Google OAuth)
# من Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. التخزين السحابي للصور والملفات (اختياري - Cloudinary)
# إذا تركتها فارغة، سيتم التخزين محلياً داخل مجلد public/uploads تلقائياً
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6. عنوان التطبيق
NEXT_PUBLIC_APP_URL=http://localhost:3006
